<Window x:Class="VirtualDesktopRDP.Dialogs.ResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:VirtualDesktopRDP.I18n"
        Title="{i18n:T 输入分辨率}"
        Width="480"
        Height="390"
        Background="#FF202024"
        FontFamily="Microsoft YaHei UI"
        Foreground="#FFE8E8E8"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ResolutionTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#FF202024" />
            <Setter Property="BorderBrush" Value="#FF707078" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Background="#FF202024"
            BorderBrush="#FF707078"
            BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF2A2A30"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="12,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="{i18n:T 输入分辨率}" />
                    <Button Width="30"
                            Height="26"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            Content="×"
                            ToolTip="{i18n:T 关闭}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,12">
                <TextBlock Foreground="#BFFFFFFF"
                           Text="{i18n:T 设置虚拟桌面的分辨率。修改后会自动重新连接 RDP，但不会注销会话。}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,18,0,8"
                           FontSize="12"
                           Foreground="#99FFFFFF"
                           Text="{i18n:T 常用分辨率}" />
                <WrapPanel>
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            Click="OnPresetClick"
                            Content="1280×720"
                            Tag="1280x720" />
                    <Button Margin="0,0,8,0"
                            Padding="12,6"
                            Click="OnPresetClick"
                            Content="1920×1080"
                            Tag="1920x1080" />
                    <Button Padding="12,6"
                            Click="OnPresetClick"
                            Content="2560×1440"
                            Tag="2560x1440" />
                </WrapPanel>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,6"
                                   Text="{i18n:T 宽}" />
                        <TextBox x:Name="WidthTextBox"
                                 PreviewTextInput="OnNumberPreviewTextInput"
                                 Style="{StaticResource ResolutionTextBox}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="0,24,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#99FFFFFF"
                               Text="×" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,6"
                                   Text="{i18n:T 高}" />
                        <TextBox x:Name="HeightTextBox"
                                 PreviewTextInput="OnNumberPreviewTextInput"
                                 Style="{StaticResource ResolutionTextBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,16,0,0"
                           FontSize="11"
                           Foreground="#80FFFFFF"
                           Text="{i18n:T 最低 800×600；最大 8192×8192。}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="#FF26262C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button MinWidth="92"
                            Padding="14,7"
                            Content="{i18n:T 取消}"
                            IsCancel="True" />
                    <Button MinWidth="92"
                            Margin="10,0,0,0"
                            Padding="14,7"
                            Click="OnConfirmClick"
                            Content="{i18n:T 确定}"
                            IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
