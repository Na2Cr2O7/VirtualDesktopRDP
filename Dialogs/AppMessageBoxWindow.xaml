<Window x:Class="VirtualDesktopRDP.Dialogs.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VirtualDesktopRDP"
        MinWidth="420"
        MaxWidth="780"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF202024"
        FontFamily="Microsoft YaHei UI"
        Foreground="#FFE8E8E8"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing"
        KeyDown="OnKeyDown">
    <!-- 外层 3px 直角边框，与主窗口按钮风格一致。 -->
    <Border Background="#FF202024"
            BorderBrush="#FF707078"
            BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF2A2A30"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="12,0">
                    <TextBlock x:Name="TitleText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="VirtualDesktopRDP" />
                    <Button x:Name="CloseButton"
                            Width="30"
                            Height="26"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnCloseClick"
                            Content="×"
                            ToolTip="关闭" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBorder"
                        Width="48"
                        Height="48"
                        VerticalAlignment="Top"
                        Background="#FF2A3A4A"
                        BorderBrush="#FF7FBFFF"
                        BorderThickness="3">
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Text="i" />
                </Border>

                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           MaxWidth="580"
                           FontSize="13"
                           LineHeight="22"
                           TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="#FF26262C"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="0,1,0,0">
                <StackPanel x:Name="ButtonsPanel"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal" />
            </Border>
        </Grid>
    </Border>
</Window>
