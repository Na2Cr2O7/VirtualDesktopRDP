<Window x:Class="VirtualDesktopRDP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:infra="clr-namespace:VirtualDesktopRDP.Infrastructure"
        Title="VirtualDesktopRDP"
        Width="1280"
        Height="752"
        MinWidth="480"
        MinHeight="360"
        Background="#FF1B1B1F"
        FontFamily="Microsoft YaHei UI"
        Foreground="#FFE8E8E8"
        Topmost="{Binding IsTopmost, Mode=OneWay}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#99FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3340A0FF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF7FBFFF" />
                                <Setter Property="Foreground" Value="#FF8CC8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 控制中心 panel 内的普通菜单项 -->
        <Style x:Key="ControlCenterItem"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="30,5,10,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- 控制中心 panel 内的可勾选菜单项，带左侧对勾 -->
        <Style x:Key="ControlCenterToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           VerticalAlignment="Center"
                                           Foreground="#FF7FBFFF"
                                           Text="✓"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#223FA0FF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF7FBFFF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlCenterSection" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,10,10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
        </Style>

    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                Background="#FF252529"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="6,0,10,0"
                             Fill="{Binding StatusBrush}"
                             ToolTip="{Binding StatusTooltip}" />
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Orientation="Horizontal">
                    <Button Command="{Binding StartCommand}"
                            Content="启动"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource ToolbarButton}" />
                    <Button Command="{Binding HideCommand}"
                            Content="隐藏"
                            Style="{StaticResource ToolbarButton}" />
                    <ToggleButton Command="{Binding ToggleWatchModeCommand}"
                                  Content="观看"
                                  IsChecked="{Binding IsWatchModeEnabled, Mode=OneWay}"
                                  Style="{StaticResource ToolbarToggleButton}"  
                                  ToolTip="{Binding WatchModeMenuHeader}" />

                    <ToggleButton x:Name="ControlCenterButton"
                                  Click="OnControlCenterButtonClick"
                                  Content="控制中心"
                                  Style="{StaticResource ToolbarToggleButton}" />

                    <!-- 控制中心使用自定义 Popup，保持与主界面一致的深色直角 3px 边框。 -->
                    <Popup x:Name="ControlCenterPopup"
                           AllowsTransparency="True"
                           Closed="OnControlCenterPopupClosed"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=ControlCenterButton}"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           VerticalOffset="4">
                        <Border Width="300"
                                Background="#FF202024"
                                BorderBrush="#FF707078"
                                BorderThickness="3">
                            <StackPanel x:Name="ControlCenterPanel" Margin="6">
                                <TextBlock Style="{StaticResource ControlCenterSection}" Text="显示" />
                                <ToggleButton Command="{Binding UseAdaptiveCommand}"
                                              Content="自适应"
                                              IsChecked="{Binding IsAdaptive, Mode=OneWay}"
                                              Style="{StaticResource ControlCenterToggle}" />
                                <ToggleButton Command="{Binding UseOneToOneCommand}"
                                              Content="1 : 1"
                                              IsChecked="{Binding IsOneToOne, Mode=OneWay}"
                                              Style="{StaticResource ControlCenterToggle}" />
                                <ToggleButton Command="{Binding ToggleKeepAspectRatioCommand}"
                                              Content="保持 16:9"
                                              IsChecked="{Binding KeepAspectRatio, Mode=OneWay}"
                                              Style="{StaticResource ControlCenterToggle}" />
                                <Button Command="{Binding ToggleSmallWindowCommand}"
                                        Content="{Binding SmallWindowMenuHeader}"
                                        Style="{StaticResource ControlCenterItem}" />
                                <Button Command="{Binding ToggleTopmostCommand}"
                                        Content="{Binding TopmostMenuHeader}"
                                        Style="{StaticResource ControlCenterItem}" />

                                <Border Height="1"
                                        Margin="8,6"
                                        Background="#33FFFFFF" />

                                <TextBlock Style="{StaticResource ControlCenterSection}" Text="快捷键" />
                                <ToggleButton Command="{Binding ToggleSendSystemShortcutsCommand}"
                                              Content="系统组合键发送到虚拟桌面"
                                              IsChecked="{Binding SendSystemShortcutsToRemote, Mode=OneWay}"
                                              Style="{StaticResource ControlCenterToggle}" />
                                <Button Command="{Binding SendShowDesktopCommand}"
                                        Content="发送 Win+D 显示桌面"
                                        Style="{StaticResource ControlCenterItem}" />

                                <Border Height="1"
                                        Margin="8,6"
                                        Background="#33FFFFFF" />

                                <TextBlock Style="{StaticResource ControlCenterSection}" Text="音频" />
                                <Button Command="{Binding ToggleAudioMutedCommand}"
                                        Content="{Binding AudioMenuHeader}"
                                        Style="{StaticResource ControlCenterItem}" />

                                <Border Height="1"
                                        Margin="8,6"
                                        Background="#33FFFFFF" />

                                <TextBlock Style="{StaticResource ControlCenterSection}" Text="更多" />
                                <Button Command="{Binding LaunchExecutableCommand}"
                                        Content="以管理员权限启动…"
                                        Style="{StaticResource ControlCenterItem}" />
                                <Button Command="{Binding RepairFirewallCommand}"
                                        Content="修复防火墙规则"
                                        Style="{StaticResource ControlCenterItem}" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Command="{Binding SettingsCommand}"
                            Content="自动启动设置"
                            Style="{StaticResource ToolbarButton}" />
                    <Button Command="{Binding CloseCommand}"
                            Content="关闭"
                            Style="{StaticResource ToolbarButton}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,5"
                Background="#FF202024"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#CCFFFFFF"
                           Text="{Binding StatusTitle}" />
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="#88FFFFFF"
                           Text="{Binding StatusTooltip}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- RDP 画面与未连接提示层 -->
        <Grid Background="Black">
            <wfi:WindowsFormsHost x:Name="RdpHostContainer"
                                  Margin="3,0,3,3"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding IsPromptVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

            <Grid Margin="24"
                  Background="#FF17171A"
                  Visibility="{Binding IsPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border MaxWidth="620"
                        Padding="36,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FF202024"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="3"
                        CornerRadius="0">
                    <StackPanel>

                        <StackPanel Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,0,9,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding StatusBrush}" />
                            <TextBlock FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding StatusTitle}" />
                        </StackPanel>

                        <TextBlock MaxWidth="510"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#BFFFFFFF"
                                   Text="{Binding StatusDescription}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,22,0,0"
                                Padding="16,12"
                                Background="#10000000"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="3"
                                CornerRadius="0">
                            <StackPanel>
                                <TextBlock Foreground="#E6FFFFFF" Text="{Binding RdpStatusText}" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#99FFFFFF"
                                           Text="{Binding ChildSessionStatusText}" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="#70FFFFFF"
                                           Text="{Binding StatusTooltip}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,24,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button MinWidth="132"
                                    Padding="14,8"
                                    Command="{Binding StartCommand}"
                                    Content="启动并连接"
                                    IsEnabled="{Binding CanStart}" />
                            <Button Margin="12,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding SettingsCommand}"
                                    Content="自动启动设置" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#80FFFFFF"
                                   Text="首次连接可能会要求输入当前 Windows 用户的凭据。"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#80FFFFFF"
                                   Text="关闭窗口会断开 RDP 并注销会话，其中程序会被关闭。"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
